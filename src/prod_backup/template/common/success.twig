{{ header }}

<div class="container">
    <div class="breadcrumbs">
        <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <span class="breadcrumbs__current">{{ breadcrumb.text }}</span>
                    </li>
                {% else %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <a href="{{ breadcrumb.href }}" class="breadcrumbs__link" itemprop="item">{{ breadcrumb.text }}</a>
                    </li>
                {% endif %}

            {% endfor %}
        </ul>
    </div>

    <div class="block-caption">
        <h1 class="title">{{ heading_title }}</h1>
    </div>

    <div class="checkout-page">
        <div class="contact-box">
            <div class="contact-box__wrap after-elem">
                <div class="contact-box__inner before-elem">
                    <div class="contact-box__border txt-elem">
                        <div class="checkout-notific">
                            <div class="checkout-notific__icon">
                                <img src="/front/dist/images/checkout-icon.svg" alt="icon" height="104" width="104">
                            </div>
                            <div class="checkout-notific__title">Заказ №{{ order_id }} успешно оформлен</div>
                            <div class="checkout-notific__subtitle">
                        
<!--
                              <b>Испытайте удачу ✨</b><br>
<b>Не закрывайте страницу — дождитесь загрузки Колеса Фортуны. </b><br><br>

Оно появится ниже на этой странице.<br>
Прокрутите колесо и узнайте свой подарок к заказу.<br><br>
                            -->
                            <small >После отправки заказа, вам поступит уведомление с номером для отслеживания</small>
                           
                            </div>
                            {% if gamelead %}
                                <div id="presentAfterPay"></div>
                            {% endif %}
                            <br>
                            <a style="display:none" href="/" class="btn btn-default">На главную</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
                            {% if gamelead %}
		<script type='text/javascript'>
		(function (d, w) {
		var s = d.createElement('script');
		s.type = 'text/javascript';
		s.charset = 'utf-8';
		s.async = true;
		s.src = 'https://game-lead.ru/set/fc22bad177ff8981eaec41e048cfc73d';
		var sc = d.getElementsByTagName('script')[0];
		if (sc) sc.parentNode.insertBefore(s, sc);
		else d.documentElement.firstChild.appendChild(s);
		})(document, window);
		</script>
                            {% endif %}
{{ footer }}