{{ header }}


<div class="main-wrapper main-not-found" style="background-image: url(/front/dist/images/not-found-bg.png)">
  <div class="main-not-found__container container">
    <div class="contact-box">
      <div class="contact-box__wrap after-elem">
        <div class="contact-box__inner before-elem">
          <div class="contact-box__border txt-elem">
            <div class="checkout-notific">
              <div class="checkout-notific__title">Ошибка 404</div>
              <div class="checkout-notific__subtitle">{{ heading_title }}</div>
              <a href="{{ continue }}" class="btn btn-default">На главную</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ footer }}
