

{% if shipping_methods %}
    {% set id = 1 %}

    {% for shipping_method in shipping_methods %}
        <p style="display: none"><strong>{{ shipping_method.title }}</strong></p>
        {% for quote in shipping_method.quote %}
            <label class="convention">
                <input type="radio" id="delivery_{{ id }}{{ quote.code }}" name="shipping_method" value="{{ quote.code }}" class="convention__check" {% if quote.code==code  %} checked="checked" {% endif %}>
                <i class="convention__mark"></i>
                <span class="convention__text class_{{ loop.index }}">
                          <span>{{ quote.title }} +{{ quote.text }}</span>
{#    {% if quote.description %}#}
{#        <p class="info">{{ quote.description }} <br/> +{{ quote.text }}</p>#}
{#    {% endif %}#}
                    {% if quote.description %}
        <p class="info">{{ quote.description }}</p>
    {% endif %}
                </span>
            </label>
        {% endfor %}
        {% set id = id + 1 %}
    {% endfor %}
{% endif %}




