{{ header }}
<div style="display: none" class="checkout-block">
    <div class="checkout-block__steps">
        <div class="checkout-block__title">{{ heading_title }}</div>
        {% if not logged %}
            <a href="#" class="checkout-block__link" id="have-account">{{ text_cart_account }}</a>
        {% endif %}
        <div class="checkout-block__step checkout-block__step-1">
            <div class="checkout-block__step-title">{{ text_cart_step_1 }}</div>
            <div class="checkout-block__step-content">
                <form class="checkout-block__form">

                    <div class="item_form_first">
                    <div class="form-block">
                        <input class="main-input" type="text">
                    </div>
                        <label class="form-label">{{ entry_firstname }}</label>
            </div>
                    <div class="item_form_first">
                    <div class="form-block">
                        <input class="main-input" type="text">
                    </div>
                        <label class="form-label">{{ entry_lastname }}</label>
                    </div>

                    <div class="item_form_first">
                    <div class="form-block">
                        <input class="main-input" type="tel">
                    </div>
                        <label class="form-label">{{ entry_telephone }}</label>
                    </div>
                    <div class="item_form_first">
                    <div class="form-block">
                        <input class="main-input" type="email">
                    </div>
                        <label class="form-label">{{ entry_email }}</label>
                    </div>

                    <div class="checkout-button" id="next-step2">{{ button_next_step }}</div>
                </form>
            </div>
        </div>
        <div class="checkout-block__step checkout-block__step-2 disabled" id="tab-2">
            <div class="checkout-block__step-title">{{ text_cart_step_2 }}</div>
            <div class="checkout-block__step-content" id="step-2-content">
                <div class="checkout-block__delivery-payment-form">
                    {# Shipping #}
                    {# Payment #}
                    {# Comment will be here #}
                    {# Confirm #}
                </div>
            </div>
        </div>
    </div>

    {# Cart #}

</div>


<div class="container">

    <div class="breadcrumbs">
        <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <span class="breadcrumbs__current">{{ breadcrumb.text }}</span>
                    </li>
                {% else %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <a href="{{ breadcrumb.href }}" class="breadcrumbs__link" itemprop="item">{{ breadcrumb.text }}</a>
                    </li>
                {% endif %}

            {% endfor %}
        </ul>
    </div>

    <div class="block-caption">
        <h1 class="title">{{ heading_title7 }}</h1>
    </div>

    <div class="checkout-page">

        <div class="date">
            <i class="date__icon">
                <img src="/front/dist/images/moment-icon.svg" alt="icon" width="14" height="14">
            </i>
            <div class="date__time">Это займет у Вас всего <span>3 минуты</span></div>
        </div>

        <form id="step-1" class="checkout-box">
            <div class="checkout-box__holder">
                <div id="step-1-content" class="checkout-box__step">

                    <div class="checkout-box__title">
                        <span class="step active">1</span>
                        <div class="checkout-box__desc">Контактные данные</div>
                        <div class="edit inactive js-slideUp">Редактировать</div>
                    </div>
                    <div class="checkout-box__wrap wrap-one">
                        <div class="status">

                            {% if firstname %}

                                <div class="status__new">Я постоянный клиент</div>
                                {#                                <div class="status__const">Я новый покупатель</div>#}
                            {% else %}
                                <div class="status__new ">Я новый покупатель</div>
                                <div style="cursor: pointer" class="status__const">Я постоянный клиент</div>


                            {% endif %}
                        </div>
                        <div class="form__box">
                            <div class="item_form_first">
                            <div class="form__row">
                                <input type="text" class="form__control" placeholder="Имя*" value="{{ firstname }}"
                                       name="firstname"></div>
                            </div>
                            <div class="item_form_first">
                            <div class="form__row">
                                <input type="text" class="form__control" placeholder="Фамилия*" value="{{ lastname }}"
                                       name="lastname"></div>
                            </div>
                            <div class="item_form_first">
                            <div class="form__row">
                                <input type="text" class="form__control" placeholder="Телефон*" value="{{ telephone }}"
                                       name="telephone"></div>
                            </div>
                            <div class="item_form_first">
                            <div class="form__row">
                                <input type="email" class="form__control" placeholder="Email*" value="{{ email }}"
                                       name="email"></div>
                            </div>

                        </div>
                        <div id="next-step" class="btn btn-default js-next2">Далее</div>
                    </div>

                </div>


                <div id="step-2-content" class="checkout-box__step">

                    <div class="checkout-box__title">
                        <span class="step">2</span>
                        <div class="checkout-box__desc">Доставка и оплата</div>
                    </div>
                    <div style="display: none" class="checkout-box__wrap">

                        <div class="delivery-title">Доставка</div>
                        <div class="delivery-subtitle">Для расчета доставки необходимо выбрать город из выпадающего списка</div>
                        <div class="form-delivery">
                            <div class="form-delivery__row">

                                <div class="select-block">
                                    <div class="select-sorting country_val">


                                        <select name="country_id" id="input-country" class="form-control search-select"
                                                data-search="Поиск по стране" data-error="Ничего не найдено">
                                            <option disabled selected value="">Страна*</option>
                                            {% for country in countries %}
                                                {% if country.country_id == country_id %}
                                                    <option value="{{ country.country_id }}"
                                                            selected="selected">{{ country.name }}</option>
                                                {% else %}
                                                    <option value="{{ country.country_id }}" data-iso="{{country.iso_code_2}}">{{ country.name }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>

                                    </div>
                                </div>
                                <div class="select-block zone_name">
{#                                    <div class="select-sorting">#}
{#                                        <select autocomplete="off" name="zone_id" id="input-zone" class="form-control search-select"#}
{#                                                data-search="Поиск по городу" data-error="Ничего не найдено">#}
{#                                            <option data-zone_name="" disabled selected value="0" selected="selected">#}
{#                                                Город*#}
{#                                            </option>#}
{#                                        </select>#}
{#                                    </div>#}
                                   <div style="">
                                        <div class="form-delivery__box">
                                            <input id="cdek-city-from" disabled="disabled" name="shipping_cdek_city_from" type="text" class="form__control" placeholder="Город">
                                            <div class="icon-container">
                                              <i class="loader"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-delivery__row row-address">
                                <div class="form-delivery__box">
                                    <input id="street" name="street" type="text" class="form__control" placeholder="Улица" disabled>
                                </div>

                                <div class="form-delivery__unit">
                                    <div class="unit-index">
                                        <input name="postcode" type="text" class="form__control" placeholder="Индекс" disabled>
                                    </div>
                                    <div class="unit-house">
                                        <input name="house" type="text" class="form__control" placeholder="Дом" disabled>
                                    </div>
                                    <div class="unit-flat">
                                        <input name="apartment" type="text" class="form__control"
                                               placeholder="Квартира" disabled>
                                    </div>
                                </div>
                            </div>
                            <div class="error-box" style="display:none;font-size:13px;color:#e58182;"></div>
                        </div>
                        <!--coupon-->
                        <div class="section-options">             
                            <div class="promo-code" style="margin-top: 10px;">
                                <div class="promo-code__txt js-promo-code">У меня есть промо-код или сертификат</div>
                                <div class="promo-code__block">
                                    {% for module in modules %}
                                        {{ module }}
                                    {% endfor %}
                                </div>
                            </div>
                         </div>
                        <div class="delivery_pay_block" style="display: none">
                            <div id="box-check" class="box-check" style="display: none">
                                <div class="box-check-title">Выбор коробки</div>
                                <label class="convention">
                                    <input type="radio" checked name="box_type" value="classic" class="convention__check">
                                    <i class="convention__mark"></i>
                                    <div class="convention__text class_1">
                                        <span>Классическая</span>
                                    </div>
                                </label>
                                <label class="convention">
                                    <input type="radio" name="box_type" value="gift" class="convention__check">
                                    <i class="convention__mark"></i>
                                    <div class="convention__text class_1">
                                        <!--<span>Подарочная (с дополнительной защитой классической коробки) + 70 руб.</span>-->
                                        <span>Дополнительная защита коробки + 70 руб</span>
                                    </div>
                                </label>
                            </div>
                            <div class="delivery-title">Служба доставки</div>
                            <div id="shipping-block" class="delivery-check"></div>
                            <div class="delivery-title">Способ оплаты</div>
                            <div id="payment-block" class="delivery-check delivery-check-pay"></div>
                        </div>
                        <div class="section-options">
                            <div class="comment">
                                <div class="comment__txt js-comment">Комментарий к заказу</div>
                                <br>
                                <small style="font-size:70%;">
                                *При заказе продукции в подарок, можно добавить поздравительную открытку с вашими пожеланиями
                                </small>
                                <div class="comment__block">
                                    <div class="form__row form__row-comment">
                                        <textarea name="comment" id="comment" class="form__control"
                                                  placeholder="Сообщение"></textarea>

                                    </div>
                                </div>
                            </div>

                            <div class="agreement">

                                <label class="convention">
                                    <input checked="checked" name="agree" type="checkbox" class="convention__check">
                                    <i class="convention__mark"></i>
                                    <span class="convention__text">Я соглашаюсь с <a href="/delivery">условиями доставки и оплаты</a></span>
                                </label>

                                <label class="convention">
                                    <input checked="checked" name="convention2" type="checkbox" class="convention__check">
                                    <i class="convention__mark"></i>
                                    <span class="convention__text">Я соглашаюсь с <a href="/privacy">публичной офертой и политикой конфиденциальности</a> и обработкой моих персональных данных</span>
                                </label>

                                <label class="convention">
                                    <input checked="checked" type="checkbox" class="convention__check">
                                    <i class="convention__mark"></i>
                                    <span class="convention__text">Я хочу получать уведомления о новинках, скидках, акциях</span>
                                </label>

                            </div>

                        </div>
                        <div id="confirm-block">

                            <div class="buttons ">
                                <div class="pull-right">
                                    <input type="submit" value="Оформить заказ" class="btn btn-order btn-default onclup disabled" disabled="">
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <div class="basket-block__wrap" id="cart-block"></div>

        </form>


    </div>
</div>


