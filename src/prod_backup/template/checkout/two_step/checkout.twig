                            <div>{{ ulogin }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





<script>
    $('.js.city-from').click(function(){
        $("#cdek-city-from").show().focus().trigger('keydown');
    //    $(this).hide();
    });

    $("#cdek-city-from").blur(function(){
        if ($('#cdek-city-from-id').val() != '') {
            $('.js.city-from').show();
        //    $(this).hide();
        }
    });

    $("#cdek-city-from").change(function(){
        $('#cdek-city-from-id').val('');
    });

    $(function() {
        $("#cdek-city-from").autocomplete({
            source: function(request,response) {
                if ($("#cdek-city-from").val()&&$("#cdek-city-from").val().trim()) {
                     $('.loader').css( "display", "block" );
                }

                 var country_id = $('.select__item.select__item--active').data('value');
                        var countryIso = 'RU'
                        if(country_id==20){
                            countryIso = 'BY'
                        }    if(country_id==109){
                            countryIso = 'KZ'
                        }
               
                $.ajax({
                 url: "//api.cdek.ru/city/getListByTerm/jsonp.php?countryCodeList="+country_id+"&=1485514316680:1&callback=?",
                // url: "https://integration.cdek.ru/v1/location/cities/json?size=5&page=0&regionCode=23",

                    dataType: "jsonp",
                    data: {
                        q: function () { return $("#cdek-city-from").val() },
                        name_startsWith: function () { return $("#cdek-city-from").val() }
                    },
                    success: function(data) {
                        $('.loader').hide();
                        // console.log(data);
                        // BY KZ RU

                        response($.map(data.geonames, function(item) {

                        var country_id = $('.select__item.select__item--active').data('value');
                        var countryIso = 'RU';

                        if(country_id==20) {
                          countryIso = 'BY';
                        } else if (country_id==109) {
                          countryIso = 'KZ';
                        }

                        if(item.countryIso==countryIso){
                            return {
                                label: item.name,
                                value: item.id,
                                id: item.id,
                            }
                        }

                        }));
                    }
                });
            },
            minLength: 1,
            select: function(event) {
               // console.log(event);
                $('#cdek-city-from-id').parent().find('.error').remove();
                $('#cdek-city-from-id').val(event.id);

                $("#cdek-city-from").val(event.label);
                $('.js.city-from').text(event.label).show();
             //   $("#cdek-city-from").hide();
            }
        });

    });
</script>





<script><!--


    // On change country
    $(document).on('change', 'select[name=\'country_id\']', function () {
        var country_id = this.value;
        $('#cdek-city-from').removeAttr('disabled')
        $.ajax({
            url: 'index.php?route=extension/total/shippingcustom/country&country_id=' + this.value,
            dataType: 'json',
            success: function (json) {

                if(country_id!=176&& country_id!=20 && country_id!=109){
                    $('#cdek-city-from').removeAttr('id')
                }else{
                  $('input[name=\'shipping_cdek_city_from\']').attr('id','cdek-city-from')
                }


                if (json['postcode_required'] == '1') {
                    $('input[name=\'postcode\']').parent().parent().addClass('required');
                } else {
                    $('input[name=\'postcode\']').parent().parent().removeClass('required');
                }
                //   console.log(json);
                html = '<option data-zone_name="" disabled selected value="">Город</option>';

                if (json['zone'] && json['zone'] != '') {
                    for (i = 0; i < json['zone'].length; i++) {
                        html += '<option data-zone_name="' + json['zone'][i]['name'] + '" value="' + json['zone'][i]['zone_id'] + '"';

                        if (json['zone'][i]['zone_id'] == '{{ zone_id }}') {
                            html += ' selected="selected"';
                        }

                        html += '>' + json['zone'][i]['name'] + '</option>';
                    }
                } else {
                    html += '<option data-zone_name="" disabled selected value="0" selected="selected">Город</option>';
                }

                $('select[name=\'zone_id\']').html(html);

                setTimeout(function () {
                    customeSelect.update('select')
                    ;
                }, 500);
                setTimeout(function () {
                 //  console.log(111);
                    // $('.select__list').mCustomScrollbar()

                }, 600);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
    // On change region2
    $(document).on('change', 'select[name="zone_id"]', function () {
        //console.log($(".zone_name .select__item--active").text());

        $.ajax({
            url: 'index.php?route=checkout/checkout_two_step/changeZone',
            type: 'post',
            cache: false,
            data: 'zone_id=' + $(this).val() + '&zone_name=' + $(".zone_name .select__item--active").text() + '&country_id=' + $('.country_val .select__item--active').data('value'),
            dataType: 'json',
            success: function (json) {
                setTimeout(function () {
                    shippingMethods();
                    $('#box-check').show('slow');
                    $('.delivery_pay_block').show('slow');
                }, 500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
    $(document).on('change', 'input[name="shipping_cdek_city_from"]', function () {
        $('#confirm-block').find('.btn-order').addClass('disabled').prop('disabled',true);
        $(this).addClass('inp-error');
        if($('input[name="shipping_cdek_city_from"]').val().length>1) {
            var country_id = $('.select__item.select__item--active').data('value');
            $.ajax({
                url: 'index.php?route=checkout/checkout_two_step/changeZone',
                type: 'post',
                cache: false,
                data: 'zone_id=999999&zone_name=' + $('input[name="shipping_cdek_city_from"]').val() + '&country_id=' + $('.country_val .select__item--active').data('value'),
                dataType: 'json',
                success: function (json) {
                    // $('#shipping-block').html('');
                    // setTimeout(function () {
                    //     shippingMethods();
                    //     $('#box-check').show('slow');
                    //     $('.delivery_pay_block').show('slow');
                    // }, 500);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        } else {
            $('.delivery_pay_block').hide();
            $('.error-box-city').remove();
            $('.form-delivery').append('<div class="error-box-city" style="font-size: 13px;color: rgb(229, 129, 130);">Необходимо указать город</div>');
        }
    });
    $(document).on('click', '.form-delivery__box li', function () {
        $('#confirm-block').find('.btn-order').addClass('disabled').prop('disabled',true);
        $.ajax({
            url: 'index.php?route=checkout/checkout_two_step/changeZone',
            type: 'post',
            cache: false,
            data: 'zone_id=' + $(this).data('value') + '&zone_name=' + $(this).text().split(',')[0] + '&country_id=' + $('.country_val .select__item--active').data('value'),
            dataType: 'json',
            success: function (json) {
                $('#shipping-block').html('');
                setTimeout(function () {
                    shippingMethods();
                    $('#box-check').show('slow');
                    $('.delivery_pay_block').show('slow');
                }, 500);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });


    $(document).on('click', '#cdek-city-from', function () {
        $(this).addClass('inp-error');
    });

    $(document).on('click', '.form-delivery__box .dropdown-menu li', function () {
