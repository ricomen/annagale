{{ header }}
<div style="display: none" id="faq" class="container">
<ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
</ul>
<div class="row">
<style>
  .collapse .panel-body span img{float:left;margin:0 10px 10px 0;}
</style>
<h3>{{ heading_title }}</h3>
<div class="panel-group" id="accordion">
  {% for faq in faqs %}
  <div class="panel panel-default">
    <div class="panel-heading">
      <a data-toggle="collapse" data-parent="#accordion" href="#collapse{{ faq.faq_id }}"><h4 class="panel-title">
        {{ faq.question }}</h4></a>
    </div>
    <div id="collapse{{ faq.faq_id }}" class="panel-collapse collapse">
      
      <div class="panel-body"><span><img src="{{ faq.image }}" alt="pic" /></span>{{ faq.answer }}</div>
    </div>
  </div>
  
  {% endfor %}
  
</div>
</div>
<div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
</div>


<div class="main-faq container">

    <div class="breadcrumbs">
        <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <span  class="breadcrumbs__current">{{ breadcrumb.text }}</span>
                    </li>
                {% else %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <a href="{{ breadcrumb.href }}" class="breadcrumbs__link" itemprop="item">{{ breadcrumb.text }}</a>
                    </li>
                    {% endif %}

            {% endfor %}
        </ul>
    </div>
    <div class="block-caption">
        <h1 class="title">FAQ</h1>
    </div>

    <div class="main-faq-block">
        <div class="accordion">
            {% for faq in faqs %}
            <div class="accordion__holder">
                <div class="trigger">
                    {{ faq.question }} <i></i>
                </div>
                <div class="trigger__content">
                    {{ faq.answer }}
                </div>
            </div>
            {% endfor %}
            {{ pagination }}
        </div>

        <div class="contact-box">
            <div class="contact-box__wrap after-elem">
                <div class="contact-box__inner before-elem">
                    <div class="contact-box__border txt-elem">
                        <form id="contact_form" class="form">
                            <div class="form__title">Остались вопросы?</div>
                            <div class="form__box">
                                <div class="form__row">
                                    <input type="text" class="form__control " name="name" value="{{ name }}" placeholder="Имя*">
                                </div>
                                <div class="form__row">
                                    <input type="email" name="email" value="{{ email }}" class="form__control " placeholder="Email">
                                </div>
                                <div class="form__row">
                                    <input  name="telephone" type="text" class="form__control" placeholder="Телефон*">
                                </div>
                                <div class="form__row form__row-comment">
                                    <textarea name="enquiry" class="form__control" placeholder="{{ entry_enquiry }} Сообщение">{{ enquiry }}</textarea>

                                </div>
                            </div>
                            <label class="convention">
                                <input  name="convention" type="checkbox" class="convention__check ">
                                <i class="convention__mark "></i>
                                <span class="convention__text">Я соглашаюсь с
                        <a href="{{ polycy }}" class="convention__link">публичной офертой и политикой конфиденциальности</a>
                      и обработкой моих персональных данных</span>
                            </label>
                            <!-- invisible reCaptcha -->
                            <div id="recaptcha-contact" class="recaptcha-block"></div>
                            <button type="submit" class="btn btn-default contact_form_button">Отправить</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
// при отправке формы contact_form на сервер (id="contact_form")
$('#contact_form').submit(function (event) {
  // отменим стандартную отправку формы на сервер
  event.preventDefault();
  // если форма прошла валидацию, то вызовем invisible reCaptcha
  if($(this).find('[name="name"]').val().length && $(this).find('[name="telephone"]').val().length && $(this).find('[name="convention"]').prop("checked")) {
    grecaptcha.execute(idCaptchaContact);
  } else {
    sendFormContact();
  }
  return false;
});
// функции, которая будет вызвана после окончания успешной проверки пользователя
function onSubmitReCaptchaContact() {
  sendFormContact();
}
function sendFormContact() {
  $('.error-inp').removeClass('error-inp');
  $.ajax({
    url: 'index.php?route=information/contact/contactForm',
    type: 'post',
    data: $('#contact_form').serialize(),
    dataType: 'json',
    success: function(json) {
      for(var key in json['error']) {
        if(json['error'].hasOwnProperty(key)) {
          if(key=='convention'){
            $('#contact_form').find('[name="' + key + '"]').parent().find('i').addClass('error-inp').css({'border':'1px solid #e58182'});
          }else{
            $('#contact_form').find('[name="' + key + '"]').addClass('error-inp');
        }

         }
      }
      if(json['suc']){
        $('#contact_form').find('input').val('');
        $('#contact_form').find('textarea').val('');
        $('#contact_form').find('.convention__check').prop('checked', false);
        $('.popup.popup-thx').addClass('active')
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
}
</script>
{{ footer }} 