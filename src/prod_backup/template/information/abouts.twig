{{ header }}

<div class="main-about container">
    <div class="breadcrumbs">
        <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                      <span class="breadcrumbs__current">{{ breadcrumb.text }}</span>
                    </li>
                {% else %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <a href="{{ breadcrumb.href }}" class="breadcrumbs__link" itemprop="item">{{ breadcrumb.text }}</a>
                    </li>
                {% endif %}

            {% endfor %}
        </ul>
    </div>
    <div class="block-caption">
        <h1 class="title">{{ heading_title }}</h1>
    </div>
    <div class="section-welcome">
        <div class="section-welcome__container">
            <div class="section-welcome__outer after-elem">
                <div class="section-welcome__inner before-elem">
                    <div class="section-welcome__col">
                        <div class="scroll-block">
                            <div class="scroll-block__title">{{ h1 }}</div>
                            <div class="scroll-block__desc scroll-text">
                                {{ description }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="section-welcome__pic">
                <img src="{{ image }}" alt="{{ heading_title }}" width="501" height="752">
            </div>
        </div>
    </div>
    <div class="structure">


        {% for trigger in triggers %}
            <div class="structure__holder {% if loop.index%2==0 %} structure__holder--reverse {% endif %}">
                <div class="structure__pic">
                    <img src="{{ trigger.image }}" alt="pic">
                </div>
                <div class="structure__box after-elem">
                    <div class="structure__outer before-elem">
                        <div class="structure__title">{{ trigger.title }}</div>
                        <div class="structure__text scroll-text">
                            {{ trigger.description }}
                        </div>
                    </div>
                </div>
            </div>
            {% if loop.first %}
               {% if column_right %}
                <div class="structure__video">
                    {{ column_right }}
                </div>
                   {% endif %}
            {% endif %}

        {% endfor %}

    </div>

    {{ content_top }}


</div>
{{ content_bottom }}

