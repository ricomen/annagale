                <form id="contact_form" class="form">
                    <div class="form__title">Остались вопросы?</div>
                    <div class="form__box">
                        <div class="form__row">
                            <input type="text" class="form__control " name="name" value="{{ name }}" placeholder="{{ entry_name }}*">
                        </div>
                        <div class="form__row">
                            <input type="email" name="email" value="{{ email }}" class="form__control " placeholder="{{ entry_email }}">
                        </div>
                        <div class="form__row">
                            <input  name="telephone" type="text" class="form__control" placeholder="Телефон*">
                        </div>
                        <div class="form__row form__row-comment">
                            <textarea name="enquiry" class="form__control" placeholder="{{ entry_enquiry }}">{{ enquiry }}</textarea>

                        </div>
                    </div>

                    <label class="convention">
                        <input  name="convention" type="checkbox" class="convention__check ">
                        <i class="convention__mark "></i>
                        <span class="convention__text">Я соглашаюсь с
                        <a href="{{ polycy }}" class="convention__link">публичной офертой и политикой конфиденциальности</a>
                      и обработкой моих персональных данных</span>
                    </label>
                    <!-- invisible reCaptcha -->
                    <div id="recaptcha-contact" class="recaptcha-block"></div>
                    <button  type="submit" class="btn btn-default contact_form_button">Отправить</button>
                </form>
            </div>
        </div>
    </div>
</div>

</div>

<script>
// при отправке формы contact_form на сервер (id="contact_form")
$('#contact_form').submit(function (event) {
  // отменим стандартную отправку формы на сервер
  event.preventDefault();
  // если форма прошла валидацию, то вызовем invisible reCaptcha
  if($(this).find('[name="name"]').val().length && $(this).find('[name="telephone"]').val().length && $(this).find('[name="convention"]').prop("checked")) {
    grecaptcha.execute(idCaptchaContact);
  } else {
    sendFormContact();
  }
  return false;
});
// функции, которая будет вызвана после окончания успешной проверки пользователя
function onSubmitReCaptchaContact() {
  sendFormContact();
}
function sendFormContact() {
  $('.error-inp').removeClass('error-inp');
  $.ajax({
    url: 'index.php?route=information/contact/contactForm',
    type: 'post',
    data: $('#contact_form').serialize(),
    dataType: 'json',
    success: function(json) {
      for(var key in json['error']) {
        if(json['error'].hasOwnProperty(key)) {
          if(key=='convention'){
            $('#contact_form').find('[name="' + key + '"]').parent().find('i').addClass('error-inp').css({'border':'1px solid #e58182'});
          }else{
            $('#contact_form').find('[name="' + key + '"]').addClass('error-inp');
        }

         }
      }
      if(json['suc']){
        $('#contact_form').find('input').val('');
        $('#contact_form').find('textarea').val('');
        $('#contact_form').find('.convention__check').prop('checked', false);
        $('.popup.popup-thx').addClass('active')
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
}
</script>

{{ footer }}