                        </a>
                      </li>
                    {% endif %}
                    {% if fb %}
                      <li class="facebook">
                        <a href="{{ fb }}" target="_blank" rel="nofollow">
                          <img src="/front/dist/images/fb-icon.svg" alt="icon" width="9" height="18">
                        </a>
                      </li>
                    {% endif %}
                    {% if vk %}
                      <li class="vk">
                        <a href="{{ vk }}" target="_blank" rel="nofollow">
                          <img src="/front/dist/images/vk-icon.svg" alt="icon" width="20" height="11">
                        </a>
                      </li>
                    {% endif %}

                    {% if telegram %}  <li class="telegram">
                      <a href="{{ telegram }}" target="_blank" rel="nofollow">
                        <img src="/front/dist/images/tel-icon.svg" alt="icon" width="20" height="17">
                      </a>
