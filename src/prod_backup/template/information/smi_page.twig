{{ header }}
<div class="main-smi container">

    <div class="breadcrumbs">
        <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <span  class="breadcrumbs__current">{{ breadcrumb.text }}</span>
                    </li>
                {% else %}
                    <li class="breadcrumbs__items" itemprop="itemListElement" itemscope
      itemtype="https://schema.org/ListItem">
                        <a href="{{ breadcrumb.href }}" class="breadcrumbs__link" itemprop="item">{{ breadcrumb.text }}</a>
                    </li>
                {% endif %}

            {% endfor %}
        </ul>
    </div>


    <div class="block-caption">
        <h1 class="title">{{ heading_title }}</h1>
    </div>

    <div class="structure">
        <div class="structure__holder">
            <div class="structure__pic">
                <img src="{{ image }}" alt="pic" width="585" height="300">
            </div>
            <div class="structure__box after-elem">
                <div class="structure__outer before-elem">
                    <div class="structure__title">{{ h1 }}</div>
                    <div class="structure__text scroll-text">
                       {{ description }}
                        </div>
                </div>
            </div>
        </div>
    </div>

    <div class="magazine-block">
        <div class="magazine-block__list">
            {% for gallery in gallerys %}
            <div class="magazine">
                <div class="magazine__holder">
                    <a href="{{ gallery.popup }}" class="magazine__pic" data-fancybox="images" data-for="magazine">
                        <img src="{{ gallery.thumb }}" alt="pic" width="379" height="473">
                    </a>
                </div>
            </div>
{% endfor %}
        </div>
{{ pagination }}

    </div>
    <!--<div class="partners-video">
    {{ content_bottom }}

    </div>-->

</div>
{{ footer }}
