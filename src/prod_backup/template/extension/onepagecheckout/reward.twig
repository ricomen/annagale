<hr/>
<div class="extsm-12">
	<div class="extinput-group">
		<input type="text" name="reward" value="{{reward}}" placeholder="{{entry_reward}}" id="input-reward" class="form-control" />
		<span class="extbtn-block">
			<button type="submit" id="button-reward" data-loading-text="{{text_loading}}"  class="btn btn-primary">{{button_reward}} {{heading_title}}</button>
		</span>
	</div>
</div>

<script><!--
$('#onepagecheckout input[name=\'reward\']').keypress(function(event) {
	var keycode = (event.keyCode ? event.keyCode : event.which);
	if(keycode == '13') {
		$('#button-reward').trigger('click');
	}
});

$('#button-reward').on('click', function() {
	$.ajax({
		url: 'index.php?route=extension/onepagecheckout/reward/reward',
		type: 'post',
		data: 'reward=' + encodeURIComponent($('input[name=\'reward\']').val()),
		dataType: 'json',
		beforeSend: function() {
			$('#button-reward').button('loading');
		},
		complete: function() {
			$('#button-reward').button('reset');
		},
		success: function(json) {
			$('.alert').remove();

			if (json['error']) {
				$('#onepagecheckout #collapse-reward label').before('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

			if (json['redirect']) {
				// Load Cart
				LoadCart();
			}
		}
	});
});
//--></script>