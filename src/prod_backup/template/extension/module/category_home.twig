

<div class="section-category">
    <div class="container">
        <div class="block-caption">
            <h1 class="title">Каталог</h1>
            <div class="block-caption__arrows category-arrows"></div>
        </div>
        <div class="category-slider">
            {% for category in categories %}
                {% if category.status == 1 %}
                <div class="box-category">
                <div class="box-category__holder">
                    <div  class="box-category__link">
                        <img src="{{ category.image }}" alt="{{ category.name }}" width="215" height="354">
                    </div>
                    <div class="box-category__icon">
                        <img src="/front/dist/images/category-info.svg" alt="icon">
                    </div>
                    <div class="box-category__info">
                        Категория в разработке
                    </div>
                    <span  class="box-category__desc">{{ category.name }}</span>
                </div>
            </div>
            {% else %}
                <div class="box-category">
                    <div class="box-category__holder">
                        <a href="{{ category.href }}" class="box-category__link">
                            <img src="{{ category.image }}" alt="{{ category.name }}" width="215" height="354">
                        </a>
                        <a href="{{ category.href }}" class="box-category__desc">{{ category.name }}</a>
                    </div>
                </div>

                {% endif %}

            {% endfor %}

        </div>
    </div>
</div>