
<div class="slideshow" style="background-image: url(/front/dist/images/slideshow-bg.jpg);">
  <div class="slideshow__container container">
    <div class="slideshow__arrows">
      <div class="slide-count"></div>
    </div>
    <div class="slideshow__slider">
      {% for banner in banners %}
      <div class="slideshow__items">
        <div class="slideshow__box">
          <div class="slideshow__block">
            <div class="slideshow__title">{{ banner.title }}</div>
            <div class="slideshow__subtitle">{{ banner.description }}</div>
            {% if banner.link %}
            <div class="btn-white">
              <a href="{{ banner.link }}" class="btn-white__link">Заказать</a>
            </div>
            {% endif %}
          </div>
          <div class="slideshow__pic">
            <img src="{{ banner.image }}" alt="pic" width="414" height="481">
          </div>
        </div>
      </div>
{% endfor %}
    </div>
  </div>
</div>
<script>
$(document).ready(function(){
      $('.slideshow__slider').slick({
dots: false,
initialSlide: 0,
infinite: true,
        speed: 400,
        slidesToShow: 1,
        autoplay: true,
        autoplaySpeed: 6000,
arrows: true,
prevArrow: '<div class="slideshow__arrows"><div class="main-arrow prev-arrow slick-arrow"><svg width="8" height="33" viewBox="0 0 8 33" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.35355 0.646446C4.15829 0.451183 3.84171 0.451183 3.64645 0.646446L0.464467 3.82843C0.269205 4.02369 0.269205 4.34027 0.464467 4.53553C0.65973 4.7308 0.976312 4.7308 1.17157 4.53553L4 1.70711L6.82843 4.53553C7.02369 4.7308 7.34027 4.7308 7.53554 4.53553C7.7308 4.34027 7.7308 4.02369 7.53554 3.82843L4.35355 0.646446ZM4.5 33L4.5 1L3.5 1L3.5 33L4.5 33Z" fill="#999999"></path></svg></div></div>',
nextArrow: '<div class="slideshow__arrows"><div class="main-arrow next-arrow slick-arrow"><svg width="8" height="33" viewBox="0 0 8 33" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.35355 0.646446C4.15829 0.451183 3.84171 0.451183 3.64645 0.646446L0.464467 3.82843C0.269205 4.02369 0.269205 4.34027 0.464467 4.53553C0.65973 4.7308 0.976312 4.7308 1.17157 4.53553L4 1.70711L6.82843 4.53553C7.02369 4.7308 7.34027 4.7308 7.53554 4.53553C7.7308 4.34027 7.7308 4.02369 7.53554 3.82843L4.35355 0.646446ZM4.5 33L4.5 1L3.5 1L3.5 33L4.5 33Z" fill="#999999"></path></svg></div></div>',
        pauseOnFocus: false,
        pauseOnHover: false
      });
    });
</script>
