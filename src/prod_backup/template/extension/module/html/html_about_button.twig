<div class="section-welcome section-welcome--reverse section-welcome--bottom">
    <div class="section-welcome__container">
        <div class="section-welcome__pic">
            <img src="{{ image }}" alt="pic" width="501" height="752">
        </div>
        <div class="section-welcome__outer after-elem">
            <div class="section-welcome__inner before-elem">
                <div class="section-welcome__col">
                    <div class="scroll-block">
                        <div class="scroll-block__title">{{ heading_title }}</div>
                        <div class="scroll-block__desc scroll-text">
                        {{ html }}
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>