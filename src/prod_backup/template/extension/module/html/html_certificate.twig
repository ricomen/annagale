<div class="section-sale section-sale--about" style="background-color: #f3f7f4">
    <div class="container">
        <div class="block-caption">
            <div class="title">{{ heading_title }}</div>
            <div class="block-caption__arrows sale-arrows"></div>
        </div>
        <div class="sale-slider">
            {% for trigger in triggers %}
            <div class="certificates">
                <a href="{{ trigger.image }}" class="certificates__img" data-fancybox="images" data-for="magazine">
                        <img src="{{ trigger.image }}" alt="pic" width="244" height="345">
                </a>
            </div>
{% endfor %}
        </div>
    </div>
</div>