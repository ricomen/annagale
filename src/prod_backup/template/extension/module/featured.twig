{% if product_listing %}


  <div class="section-{{ class }} " {% if status_shodowb!=1 %}  {% if modul_image %} style="background: url({{ modul_image }}) no-repeat" {% else %}style="background-color: #f3f7f4"{% endif %}{% endif %}>
    <div class="container">
      <div class="block-caption">
        <h1 class="title">{{ modul_title }}</h1>
        <div class="block-caption__arrows {{ class }}-arrows"></div>
      </div>
      <div class="{{ class }}-slider">

        {{ product_listing }}

      </div>
    </div>
  </div>



{% endif %}