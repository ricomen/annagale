{% if testmode %}
<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ text_testmode }}</div>
{% endif %}
<div id="active_pp" action="{{ action }}" method="post">
  <input type="hidden" name="cmd" value="_cart" />
  <input type="hidden" name="upload" value="1" />
  <input type="hidden" name="business" value="{{ business }}" />
  {% set i = 1 %}
  {% for product in products %}
  <input type="hidden" name="item_name_{{ i }}" value="{{ product.name }}" />
  <input type="hidden" name="item_number_{{ i }}" value="{{ product.product_id }}" />
  <input type="hidden" name="amount_{{ i }}" value="{{ product.price }}" />
  <input type="hidden" name="quantity_{{ i }}" value="{{ product.quantity }}" />
  <input type="hidden" name="weight_{{ i }}" value="{{ product.weight }}" />
  {% set j = 0 %}
  {% for option in product.option %}
  <input type="hidden" name="on{{ j }}_{{ i }}" value="{{ option.name }}" />
  <input type="hidden" name="os{{ j }}_{{ i }}" value="{{ option.value }}" />
  {% set j = j + 1 %}
  {% endfor %}
  {% set i = i + 1 %}
  {% endfor %}
  {% if discount_amount_cart %}
  <input type="hidden" name="discount_amount_cart" value="{{ discount_amount_cart }}" />
  {% endif %}
  <input type="hidden" name="currency_code" value="{{ currency_code }}" />
  <input type="hidden" name="first_name" value="{{ first_name }}" />
  <input type="hidden" name="last_name" value="{{ last_name }}" />
  <input type="hidden" name="address1" value="{{ address1 }}" />
  {% if address2 %}
  <input type="hidden" name="address2" value="{{ address2 }}" />
  {% endif %}
  
  <input type="hidden" name="city" value="{{ city }}" />
   {% if zip %}
  <input type="hidden" name="zip" value="{{ zip }}" />
    {% endif %}
  <input type="hidden" name="country" value="{{ country }}" />
  <input type="hidden" name="address_override" value="0" />
  <input type="hidden" name="email" value="{{ email }}" />
  <input type="hidden" name="invoice" value="{{ invoice }}" />
  <input type="hidden" name="lc" value="{{ lc }}" />
  <input type="hidden" name="rm" value="2" />
  <input type="hidden" name="no_note" value="1" />
  <input type="hidden" name="no_shipping" value="1" />
  <input type="hidden" name="charset" value="utf-8" />
  <input type="hidden" name="return" value="{{ return }}" />
  <input type="hidden" name="notify_url" value="{{ notify_url }}" />
  <input type="hidden" name="cancel_return" value="{{ cancel_return }}" />
  <input type="hidden" name="paymentaction" value="{{ paymentaction }}" />
  <input type="hidden" name="custom" value="{{ custom }}" />
  <input type="hidden" name="bn" value="OpenCart_2.0_WPS" />
  <div class="buttons">
    <div class="pull-right">
      <input type="submit" value="{{ button_confirm }}" class=" btn btn-order btn-default onclup" />
    </div>
  </div>
</div>

<script>


  $(document).delegate('.onclup','click', function(e) {
    e.preventDefault();

    $('.active_pp ')

    var age =$('input[name=\'agree\']:checked').val();
    var convertion =$('input[name=\'convention2\']:checked').val();
    $('.error-inp').removeClass('error-inp');
    $('input[name=\'agree\']').parent().find('i').removeAttr('style');
    $('input[name=\'convention2\']').parent().find('i').removeAttr('style');

    if(typeof age !='undefined'&& typeof convertion !='undefined'){
      $('.onclup').removeClass('onclup').trigger('click')
    }else{

      if(typeof age =='undefined'){
        $('input[name=\'agree\']').parent().find('i').addClass('error-inp').css({'border':'1px solid #e58182'});
      }  if(typeof convertion =='undefined'){
        $('input[name=\'convention2\']').parent().find('i').addClass('error-inp').css({'border':'1px solid #e58182'});
      }


    }

  })



  $(document).ready(function () {
    $("#active_pp").replaceWith(function(index, oldHTML){
      return $("<form>").html(oldHTML);
    });
    $('#confirm-block form').attr({'id':'active_pp','action':'{{ action }}','method':'post'})
    if($('.row-address input.error-inp').length) {
        $('#confirm-block').find('.btn-order').addClass('disabled').prop('disabled',true);	
    }
  })
</script>
