<div class="promo-code__desc">Введите в данное поле код  специальный промо-код, для получения скидки или подарка. После ввода кода, нажмите кнопку «Применить промо-код».
</div>
<div class="form__row form__row-comment">
  <input name="coupon" value="{{ coupon }}" id="input-coupon"  type="text" class="form__control" placeholder="Промо-код">
</div>
<button id="promo-send" class="promo-code__apply">Применить промо-код</button>
<div class="popup popup-coupon">
  <div class="popup__overlay"></div>
  <div class="popup__holder">
    <div class="popup__close">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.22001e-05 1L1.00003 0L10 9L9 10L3.22001e-05 1Z" fill="#57855F"/>
        <path d="M9.99997 1L8.99997 0L0 9L0.999997 10L9.99997 1Z" fill="#57855F"/>
      </svg>
    </div>
    <div class="popup__content popup__content--basket popup__content--thx">
      <div class="items items-thx">
        <div class="items__wrap after-elem">
          <div class="items__inner before-elem">
            <div class="items__border txt-elem">
              <div class="thanks">
                <div class="thanks__icon">
                  <img src="/front/dist/images/thanks-icon.svg" alt="pic" width="72" height="74">
                </div>
                <div class="thanks__title">Данные успешно сохранены</div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>