<div class="panel panel-default">
  <div id="collapse-reward" class="panel-collapse collapse">
    <div class="panel-body">
      <label class="col-sm-2 control-label" for="input-reward">{{ entry_reward }}</label>
      <div class="input-group">
        <input type="text" name="rewards" value="{{ reward }}" placeholder="" id="input-rewards" class="form-control" />
        <span class="input-group-btn">
        <button type="submit" id="button-rewards" data-loading-text="{{ text_loading }}"  class="btn btn-primary" />{{ button_reward }}</button>
        </span></div>

      <script>
$('#button-rewards').on('click', function() {
	$.ajax({
		url: 'index.php?route=extension/total/rewards/reward',
		type: 'post',
		data: 'reward=' + encodeURIComponent($('input[name=\'rewards\']').val()),
		dataType: 'json',
		beforeSend: function() {
			$('#button-rewards').text('loading');
		},
		complete: function() {
			$('#button-rewards').text('reset');
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('.breadcrumb').after('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');

				$('html, body').animate({ scrollTop: 0 }, 'slow');
			}

			if (json['redirect']) {
				location = json['redirect'];
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
</script>
    </div>
  </div>
</div>




