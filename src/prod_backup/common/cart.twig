<div class="popup popup-basket">
  <div class="popup__overlay"></div>
  <div class="popup__holder">
    <div class="popup__close">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.22001e-05 1L1.00003 0L10 9L9 10L3.22001e-05 1Z" fill="#57855F"/>
        <path d="M9.99997 1L8.99997 0L0 9L0.999997 10L9.99997 1Z" fill="#57855F"/>
      </svg>
    </div>
    <div class="popup__content popup__content--basket">
      <div class="items">
        <div class="items__wrap after-elem">
          <div class="items__inner before-elem">
            <div class="items__border txt-elem {% if not products %}card-empty{% endif %}">
              <div class="form">
{% if products %}
                <div class="form__title">Товары в корзине</div>
                <ul class="items-box scroll-text">
                  {% for product in products %}
                  <li class="items-box__list">
                    <div class="items-box__pic">
                      <img src="{{ product.thumb }}" alt="pic" width="70" height="70">
                    </div>
                    <div class="items-box__holder">
                      <i onclick="removeProductCart('{{ product.cart_id }}');" title="{{ button_remove }}" class="items-box__close">
                        <img src="/front/dist/images/close-icon.svg" alt="icon" height="12" width="12">
                      </i>
                      <span class="items-box__desc">{{ product.name }}</span>
                      {% if product.option %}
                        {% for option in product.option %} <br />
                          - <small>{{ option.name }} {{ option.value }}</small> {% endfor %}
                      {% endif %}
                      <div class="items-box__row">
                        <div class="amount">
                          <div class="amount__holder">
                            <button data-key="{{ product.cart_id }}" data-quantity="{{ product.quantity }}" type="button" class="amount__btn btn-minus"></button>
                            <div class="amount__control">
                              <input value="{{ product.quantity }}" type="text" class="amount__inp" >
                            </div>
                            <button data-key="{{ product.cart_id }}" data-quantity="{{ product.quantity }}" type="button" class="amount__btn btn-plus"></button>
                          </div>
                        </div>
                        <strong class="price">{{ product.total }}</strong>
                      </div>
                    </div>
                  </li>
                 {% endfor %}
                </ul>
                <div class="total">
                  {% for total in totals %}
                    <span>{{ total.title }}: </span>
                    <strong>{{ total.text }}</strong>


                  {% endfor %}

                </div>

                <label style="display: none" class="convention">
                  <input type="checkbox" class="convention__check">
                  <i class="convention__mark"></i>
                  <span class="convention__text">Я хочу получать уведомления о новинках, скидках, акциях</span>
                </label>
                <a href="{{ checkout }}"><button type="submit" class="btn btn-default">{{ text_checkout }}</button></a>
{% else %}
                <div class="form__title">{{ text_empty }}</div>


                </div>

                {% endif %}


              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
