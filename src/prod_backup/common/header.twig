<div class="wrapper">
<div class="{% if class=='home' %}{% else %} main-wrapper {% endif %}">

  <header class="header">
    <div class="header__holder">
      <div class="header__phone">
        <a href="tel:{{ telephone }}">{{ telephone }}</a>
      </div>

      <div class="header__slider">
        <div class="header__slider-holder">
          <div class="header__slider-wrap">
            <div class="header__slider-icon">
              <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0H3V3H0V0Z" fill="#4b601e"/>
                <path d="M7 0H10V3H7V0Z" fill="#4b601e"/>
                <path d="M14 0H17V3H14V0Z" fill="#4b601e"/>
                <path d="M0 7H3V10H0V7Z" fill="#4b601e"/>
                <path d="M7 7H10V10H7V7Z" fill="#4b601e"/>
                <path d="M14 7H17V10H14V7Z" fill="#4b601e"/>
                <path d="M0 14H3V17H0V14Z" fill="#4b601e"/>
                <path d="M7 14H10V17H7V14Z" fill="#4b601e"/>
                <path d="M14 14H17V17H14V14Z" fill="#4b601e"/>
              </svg>
            </div>
            <span class="header__slider-text">Каталог</span>
          </div>
          <div class="header-slider inactive">

            <div class="header-slider__close">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.22001e-05 1L1.00003 0L10 9L9 10L3.22001e-05 1Z" fill="#57855F"/>
                <path d="M9.99997 1L8.99997 0L0 9L0.999997 10L9.99997 1Z" fill="#57855F"/>
              </svg>
            </div>
            <div class="header-slider__box after-elem">
              <div class="header-slider__block before-elem">
                <div class="header-slider__border txt-elem">
                  <div class="header-slider__list">

                    {{ menu }}

                  </div>
                </div>
                <div class="header-slider__arrows"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="header__nav">
        <nav class="nav">
          <ul class="nav__menu">
              <li class="menu-item menu-item_catalog"></li>
            {% for menu in menu_header %}
              {% if menu.cildren %}
            <li class="menu-item menu-item-has-children">
              <a href="{{ menu.href }}">{{ menu.name }}</a>
              <ul class="sub-menu">
                {% for cildren in menu.cildren %}
                <li class="menu-item"><a href="{{ cildren.href }}">{{ cildren.name }}</a></li>
                {% endfor %}

              </ul>
            </li>
            {% else %}
            <li class="menu-item"><a href="{{ menu.href }}">{{ menu.name }}</a></li>
              {% endif %}
              {# {% if loop.index == 1 %}
              <li class="menu-item menu-item_catalog"></li>
              {% endif %} #}
            {% endfor %}

          </ul>
        </nav>
        <div class="logo" itemscope itemtype="http://schema.org/Organization">
          {% if class !='home'  %}
            <a href="{{ base }}" class="logo__home" itemprop="url">
              <img src="/front/dist/images/logo.svg" width="178" height="95" alt="logo" class="logo-lg" itemprop="logo" />
              <img src="/front/dist/images/logo-small.svg" width="36" height="36" alt="logo-small" class="logo-sm">
            </a>
          {% else %}
            <div class="logo__home">
              <img src="/front/dist/images/logo.svg" width="178" height="95" alt="logo" class="logo-lg" itemprop="logo" />
              <img src="/front/dist/images/logo-small.svg" width="36" height="36" alt="logo-small" class="logo-sm">
            </div>
          {% endif %}
        </div>
        {% if menu_header_right %}
        <nav class="nav">
          <ul class="nav__menu">
            {% for menu_right in menu_header_right %}
              <li class="menu-item"><a href="{{ menu_right.href }}">{{ menu_right.name }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        {% endif %}
      </div>
