                                                <button type="button" class="amount__btn btn-plus_popups_list"></button>
                                            </div>
                                        </div>
                                        <div class="added-items__price">0</div>
                                    </div>
                                </div>
                                <div class="form-added__btns">
                                    <div style="position: inherit" class="btn btn-transp popup__close">продолжить покупки</div>
                                    <a href="https://annagale.ru/index.php?route=checkout/checkout_two_step" class="btn btn-default">в корзину</a>
                                </div>
