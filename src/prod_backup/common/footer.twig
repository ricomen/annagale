<script>
    // Change quantity (minus)
    $(document).on('click', '.btn-minus_popups_list', function () {
        var quantity = Number($(this).parent().find('input').val()) - 1;
        var price = $(this).data('price');

        if (quantity > 0) {
            var id = $(this).attr('data-key');
			$(this).parent().find('.amount__inp').val(quantity);
            price = Number(price) * Number(quantity);
            $('.popup-added-list .added-items__price').text(price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + ' РУБ');
            uppopupList($(this),'minus');
        }
    });

    // Change quantity (plus)
    $(document).on('click', '.btn-plus_popups_list', function () {
        var quantity = Number($(this).parent().find('input').val()) + 1;
        var price = $(this).data('price');
        $(this).parent().find('.amount__inp').val(quantity);
		price = Number(price) * Number(quantity);
		$('.popup-added-list .added-items__price').text(price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + ' РУБ');
		uppopupList($(this),'plus');
    });

    function uppopupList(element,action) {
    	var url = 'index.php?route=checkout/cart/add';
    	var quantity = 1;
    	var textError = 'Не удалось добавить товар в корзину';
    	var key = '';
    	if(action == 'minus') {
    		url = 'index.php?route=checkout/cart/edit';
    		quantity =  $('.popup.popup-basket').find('[data-key="' + element.data('key') + '"].btn-minus').data('quantity') - 1;
    		textError = 'Не удалось уменьшить количество товара в корзине';
    		key = '&key=' + element.data('key');
    	}
        $.ajax({
            url: url,
            type: 'post',
			data: 'product_id=' + $('.popup-added-list').data('product-id') + '&quantity=' + quantity + key,
            dataType: 'json',
            success: function (json) {
                element.siblings('.text-danger').remove();
                if (json['error']) {
                	element.after('<div class="text-danger" style="position:absolute;top:-15px;font-size:10px;width:196px;text-align:center;color:red;">' + textError + '</div>');
                }
                if (json['success']) {
                    $('[data-for=\'popup-basket\'] .cout__holder').text(json['total']);
                    if (json['product']) {
                        $('.popup-added-list .added-items__desc').text(json['product']['name']);
                        $('.popup-added-list .amount__inp').attr('placeholder', json['product']['quantity']);
                        $('.popup-added-list .added-items__pic img').attr('src', json['product']['image']);
                    }
                    $.get("index.php?route=common/cart/info", '.popup-basket', function (data) {
                        $(".popup-basket").html(data);
                        // $('.scroll-text').mCustomScrollbar();

                    });
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }

    $('.button-cart-list').on('click', function (e) {
      e.preventDefault();
		var productId = $(this).data('id');
        $.ajax({
            url: 'index.php?route=checkout/cart/add',
            type: 'post',
            data: 'product_id=' + productId + '&quantity=1',
            dataType: 'json',
            success: function (json) {
                $(this).siblings('.text-danger').remove();
                if (json['error']) {
                	$(this).after('<div class="text-danger" style="position:absolute;top:-15px;font-size:10px;width:196px;text-align:center;color:red;">Не удалось добавить товар в корзину</div>');
                }
                if (json['success']) {
                    $('.popup-added-list').addClass('active');
                    $('[data-for=\'popup-basket\'] .cout__holder').text(json['total']);
                    if (json['product']) {
                    	$('.popup-added-list').data('product-id', productId);
                        $('.popup-added-list .added-items__desc').html(json['product']['name']);
                        var price = Number(json['product']['price']) * Number(json['product']['quantity']);
                        $('.popup-added-list .amount__btn').attr('data-price', json['product']['price']);
                        $('.popup-added-list .added-items__price').text(price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + ' РУБ');
                        $('.popup-added-list .amount__inp').attr('placeholder', json['product']['quantity']);
                        $('.popup-added-list .amount__inp').val(json['product']['quantity']);
                        $('.popup-added-list .added-items__pic img').attr('src', json['product']['image']);
                        $('.popup-added-list .btn-minus_popups_list').attr('data-key', json['cart_id']);
                    }

                    $.get("index.php?route=common/cart/info", '.popup-basket', function (data) {
                        $('.popup.popup-basket').html(data);
                        // $('.scroll-text').mCustomScrollbar();

                    });


                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
    // reCAPTCHA
    var idCaptchaContact, idCaptchaRegistration, idCaptchaModalQuestion, idCaptchaModalCallback;
    var onloadReCaptchaInvisible = function() {
      if($('#contact_form').length) {
        idCaptchaContact = grecaptcha.render('recaptcha-contact', {
          "sitekey":"6LcNlbEaAAAAAEYa7S8mkdBJ7AsVhUpsFg0fWwg7",
          "callback": "onSubmitReCaptchaContact",
          "size":"invisible"
        });
      }
      if($('#registration-form').length) {
        idCaptchaRegistration = grecaptcha.render('recaptcha-registration', {
          "sitekey":"6LcNlbEaAAAAAEYa7S8mkdBJ7AsVhUpsFg0fWwg7",
          "callback": "onSubmitReCaptchaRegistration",
          "size":"invisible"
        });
      }
      if($('#que_pay').length) {
        idCaptchaModalQuestion = grecaptcha.render('recaptcha-question', {
          "sitekey":"6LcNlbEaAAAAAEYa7S8mkdBJ7AsVhUpsFg0fWwg7",
          "callback": "onSubmitReCaptchaModalQuestion",
          "size":"invisible"
        });
      }
      if($('#pay_mail').length) {
        idCaptchaModalCallback = grecaptcha.render('recaptcha-callback', {
          "sitekey":"6LcNlbEaAAAAAEYa7S8mkdBJ7AsVhUpsFg0fWwg7",
          "callback": "onSubmitReCaptchaModalCallback",
          "size":"invisible"
        });
      }
       if($('#notify_mail').length) {
        idCaptchaModalNotify = grecaptcha.render('recaptcha-notify', {
          "sitekey":"6LcNlbEaAAAAAEYa7S8mkdBJ7AsVhUpsFg0fWwg7",
          "callback": "onSubmitReCaptchaModalNotify",
          "size":"invisible"
        });
      }
    };
</script>

